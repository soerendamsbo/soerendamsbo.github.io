{"title":"Research","markdown":{"yaml":{"title":"Research","listing":[{"id":"articles","contents":"site-data/publications.yml","include":{"type":"article"},"template":"_templates/publications.ejs","sort":false},{"id":"chapters","contents":"site-data/publications.yml","include":{"type":"chapter"},"template":"_templates/publications.ejs","sort":false},{"id":"wp-list","contents":"site-data/publications.yml","include":{"type":"working-paper"},"template":"_templates/publications.ejs","sort":false}]},"headingText":"Journal articles","headingAttr":{"id":"","classes":["pub-section"],"keyvalue":[]},"containsRefs":false,"markdown":"\n\n<!-- Entries live in site-data/publications.yml; layout in _templates/publications.ejs -->\n\nCitation counts are on {{< fa brands google-scholar >}} [Google Scholar](https://scholar.google.com/citations?user=TeuKGQ0AAAAJ&hl=en).\n\n```{=html}\n<div class=\"filter-chips\" role=\"group\" aria-label=\"Filter by theme\">\n  <button type=\"button\" class=\"chip active\" data-filter=\"all\">All</button>\n  <button type=\"button\" class=\"chip\" data-filter=\"climate\">Climate</button>\n  <button type=\"button\" class=\"chip\" data-filter=\"voting\">Voting &amp; Attitudes</button>\n  <button type=\"button\" class=\"chip\" data-filter=\"representation\">Representation &amp; Harassment</button>\n</div>\n```\n\n\n::: {#articles}\n:::\n\n## Book chapters {.pub-section}\n\n::: {#chapters}\n:::\n\n## Working papers {.pub-section}\n\n::: {#wp-list}\n:::\n\n```{=html}\n<script>\ndocument.addEventListener(\"click\", (e) => {\n  const toggle = e.target.closest(\".pub-toggle\");\n  if (toggle) {\n    const abs = document.getElementById(toggle.getAttribute(\"aria-controls\"));\n    const open = toggle.getAttribute(\"aria-expanded\") === \"true\";\n    toggle.setAttribute(\"aria-expanded\", String(!open));\n    abs.hidden = open;\n    return;\n  }\n  const chip = e.target.closest(\".filter-chips .chip\");\n  if (!chip) return;\n  const f = chip.dataset.filter;\n  document.querySelectorAll(\".filter-chips .chip\").forEach((c) => c.classList.toggle(\"active\", c === chip));\n  document.querySelectorAll(\".pub\").forEach((p) => {\n    p.hidden = f !== \"all\" && !p.dataset.topics.split(\" \").includes(f);\n  });\n  // Hide a section heading when none of its entries match\n  document.querySelectorAll(\"section.pub-section\").forEach((s) => {\n    s.hidden = !s.querySelector(\".pub:not([hidden])\");\n  });\n});\n\n// Key-finding figures: grow the thumbnail into a near-full-screen view and\n// shrink it back on click or Esc\nconst reduceMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\ndocument.addEventListener(\"click\", (e) => {\n  const thumb = e.target.closest(\".pub-fig img\");\n  if (thumb) zoomFigure(thumb);\n});\nfunction zoomFigure(thumb) {\n  const ratio = thumb.naturalWidth / thumb.naturalHeight;\n  const w = Math.min(window.innerWidth * 0.94, window.innerHeight * 0.9 * ratio);\n  const h = w / ratio;\n  const left = (window.innerWidth - w) / 2, top = (window.innerHeight - h) / 2;\n  // Transform that places the big image exactly over the thumbnail\n  const overThumb = () => {\n    const r = thumb.getBoundingClientRect();\n    return `translate(${r.left - left}px, ${r.top - top}px) scale(${r.width / w})`;\n  };\n  const back = document.createElement(\"div\");\n  back.className = \"fig-zoom-back\";\n  const img = document.createElement(\"img\");\n  img.className = \"fig-zoom-img\";\n  img.src = thumb.currentSrc || thumb.src;\n  img.alt = thumb.alt;\n  Object.assign(img.style, { left: left + \"px\", top: top + \"px\", width: w + \"px\", height: h + \"px\", transform: overThumb() });\n  document.body.append(back, img);\n  thumb.style.visibility = \"hidden\";\n  requestAnimationFrame(() => requestAnimationFrame(() => {\n    back.classList.add(\"open\");\n    img.style.transform = \"none\";\n  }));\n  const done = () => { img.remove(); back.remove(); thumb.style.visibility = \"\"; };\n  const close = () => {\n    document.removeEventListener(\"keydown\", onKey);\n    back.classList.remove(\"open\");\n    if (reduceMotion) return done();\n    img.style.transform = overThumb();\n    img.addEventListener(\"transitionend\", done, { once: true });\n  };\n  const onKey = (ev) => { if (ev.key === \"Escape\") close(); };\n  back.addEventListener(\"click\", close);\n  img.addEventListener(\"click\", close);\n  document.addEventListener(\"keydown\", onKey);\n}\n</script>\n```\n","srcMarkdownNoYaml":"\n\n<!-- Entries live in site-data/publications.yml; layout in _templates/publications.ejs -->\n\nCitation counts are on {{< fa brands google-scholar >}} [Google Scholar](https://scholar.google.com/citations?user=TeuKGQ0AAAAJ&hl=en).\n\n```{=html}\n<div class=\"filter-chips\" role=\"group\" aria-label=\"Filter by theme\">\n  <button type=\"button\" class=\"chip active\" data-filter=\"all\">All</button>\n  <button type=\"button\" class=\"chip\" data-filter=\"climate\">Climate</button>\n  <button type=\"button\" class=\"chip\" data-filter=\"voting\">Voting &amp; Attitudes</button>\n  <button type=\"button\" class=\"chip\" data-filter=\"representation\">Representation &amp; Harassment</button>\n</div>\n```\n\n## Journal articles {.pub-section}\n\n::: {#articles}\n:::\n\n## Book chapters {.pub-section}\n\n::: {#chapters}\n:::\n\n## Working papers {.pub-section}\n\n::: {#wp-list}\n:::\n\n```{=html}\n<script>\ndocument.addEventListener(\"click\", (e) => {\n  const toggle = e.target.closest(\".pub-toggle\");\n  if (toggle) {\n    const abs = document.getElementById(toggle.getAttribute(\"aria-controls\"));\n    const open = toggle.getAttribute(\"aria-expanded\") === \"true\";\n    toggle.setAttribute(\"aria-expanded\", String(!open));\n    abs.hidden = open;\n    return;\n  }\n  const chip = e.target.closest(\".filter-chips .chip\");\n  if (!chip) return;\n  const f = chip.dataset.filter;\n  document.querySelectorAll(\".filter-chips .chip\").forEach((c) => c.classList.toggle(\"active\", c === chip));\n  document.querySelectorAll(\".pub\").forEach((p) => {\n    p.hidden = f !== \"all\" && !p.dataset.topics.split(\" \").includes(f);\n  });\n  // Hide a section heading when none of its entries match\n  document.querySelectorAll(\"section.pub-section\").forEach((s) => {\n    s.hidden = !s.querySelector(\".pub:not([hidden])\");\n  });\n});\n\n// Key-finding figures: grow the thumbnail into a near-full-screen view and\n// shrink it back on click or Esc\nconst reduceMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\ndocument.addEventListener(\"click\", (e) => {\n  const thumb = e.target.closest(\".pub-fig img\");\n  if (thumb) zoomFigure(thumb);\n});\nfunction zoomFigure(thumb) {\n  const ratio = thumb.naturalWidth / thumb.naturalHeight;\n  const w = Math.min(window.innerWidth * 0.94, window.innerHeight * 0.9 * ratio);\n  const h = w / ratio;\n  const left = (window.innerWidth - w) / 2, top = (window.innerHeight - h) / 2;\n  // Transform that places the big image exactly over the thumbnail\n  const overThumb = () => {\n    const r = thumb.getBoundingClientRect();\n    return `translate(${r.left - left}px, ${r.top - top}px) scale(${r.width / w})`;\n  };\n  const back = document.createElement(\"div\");\n  back.className = \"fig-zoom-back\";\n  const img = document.createElement(\"img\");\n  img.className = \"fig-zoom-img\";\n  img.src = thumb.currentSrc || thumb.src;\n  img.alt = thumb.alt;\n  Object.assign(img.style, { left: left + \"px\", top: top + \"px\", width: w + \"px\", height: h + \"px\", transform: overThumb() });\n  document.body.append(back, img);\n  thumb.style.visibility = \"hidden\";\n  requestAnimationFrame(() => requestAnimationFrame(() => {\n    back.classList.add(\"open\");\n    img.style.transform = \"none\";\n  }));\n  const done = () => { img.remove(); back.remove(); thumb.style.visibility = \"\"; };\n  const close = () => {\n    document.removeEventListener(\"keydown\", onKey);\n    back.classList.remove(\"open\");\n    if (reduceMotion) return done();\n    img.style.transform = overThumb();\n    img.addEventListener(\"transitionend\", done, { once: true });\n  };\n  const onKey = (ev) => { if (ev.key === \"Escape\") close(); };\n  back.addEventListener(\"click\", close);\n  img.addEventListener(\"click\", close);\n  document.addEventListener(\"keydown\", onKey);\n}\n</script>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":false,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","output-file":"research.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"O