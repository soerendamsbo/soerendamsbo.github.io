<%
// Renders entries from site-data/outreach.yml. Used by media.qmd.
// Styles: .out-* rules in theme.scss. Type filter: script in media.qmd.
// Expects date-format "D MMM YYYY" (the year heading is taken from the date's last four characters).
const labels = { interview: "Interview", "op-ed": "Op-ed", podcast: "Podcast", radio: "Radio", reference: "Cited", talk: "Talk" };
const icons = { podcast: "podcast", radio: "radio", "op-ed": "pen-nib", reference: "quote-right", talk: "person-chalkboard" }; // default: newspaper
const joinNames = (xs) => xs.length <= 1 ? (xs[0] || "") : xs.slice(0, -1).join(", ") + " & " + xs[xs.length - 1];
const yearOf = (item) => String(item.date).slice(-4);
const outlets = new Set(items.map((i) => i.outlet).filter(Boolean));
const nTalks = items.filter((i) => i.type === "talk").length;
let lastYear = null;
%>
```{=html}
<p class="out-stats"><strong><%= items.length - nTalks %></strong> media appearances &middot; <strong><%= outlets.size %></strong> outlets &middot; <strong><%= nTalks %></strong> talks</p>
<div class="list out-list">
<% for (const item of items) {
  const year = yearOf(item);
  let form = item.label || labels[item.type] || item.type;
  if (item.coauthors && item.coauthors.length) form += " with " + joinNames(item.coauthors);
  const source = [item.programme, item.outlet || item.venue].filter(Boolean).join(", ");
  const dayMonth = item.month_only ? String(item.date).slice(0, -5).replace(/^\d+\s+/, "") : String(item.date).slice(0, -5);
%>
<% if (year !== lastYear) { lastYear = year; %><h3 class="out-year" data-year="<%= year %>"><%= year %></h3><% } %>
<div class="out-item" data-type="<%= item.type %>" data-year="<%= year %>" <%= metadataAttrs(item) %>>
  <span class="out-icon out-icon-<%= item.type %>"><i class="fa-solid fa-<%= icons[item.type] || "newspaper" %>" aria-hidden="true"></i></span>
  <div class="out-body">
    <p class="out-title"><% if (item.url) { %><a href="<%= item.url %>"><%= item.title %></a><% } else { %><%= item.title %><% } %><% if (item.language === "en") { %> <span class="out-lang">EN</span><% } %></p>
    <p class="out-meta"><span class="out-form"><%= form %></span> &middot; <%= source %> &middot; <%= dayMonth %><% if (item.paywalled) { %> &middot; <span class="out-paywall"><i class="fa-solid fa-lock" aria-hidden="true"></i> paywall</span><% } %><% if (item.slides) { %> &middot; <a class="out-related" href="<%= item.slides %>">slides &#8599;</a><% } %><% for (const r of (item.related || [])) { %> &middot; <a class="out-related" href="research.html#pub-<%= r %>">the research &rarr;</a><% } %></p>
  </div>
</div>
<% } %>
</div>
```
